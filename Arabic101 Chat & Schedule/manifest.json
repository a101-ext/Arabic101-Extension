{
  "key": "",
  "manifest_version": 3,
  "name": "Arabic101 Assistant",
  "version": "1.0.6",
  "description": "Arabic101 Dashboard Assistant: Chat support and Google Calendar schedule synchronization.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://dashboard.arabic101.org/*"
  ],
  "background": {
    "service_worker": "schedule_background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dashboard.arabic101.org/*"
      ],
      "js": ["schedule_script.js", "chat.js"],
      "run_at": "document_idle"
    }
  ],
  "oauth2": {
    "client_id": "392874722697-97fbhk0bvd0v4d7smqrdjoek2utdln18.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "action": {
    "default_icon": "icon48.png",
    "default_title": "Arabic101 Assistant"
  }
}